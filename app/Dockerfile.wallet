# Isolated sandbox API. No dotenv, production merchant or relayer is copied.
FROM oven/bun:1.4.4-debian@sha256:93d5032fe06d163427822dc1598f420363759bb18155c9cc90eb1be05a64a19e AS builder
WORKDIR /app
COPY package.json bun.lock ./
RUN --mount=type=cache,id=mindbliss-bun,target=/root/.bun/install/cache,sharing=locked bun install --frozen-lockfile
COPY tsconfig.json drizzle.config.ts ./
COPY src ./src
COPY scripts ./scripts
RUN bun run typecheck

FROM oven/bun:1.4.4-debian@sha256:93d5032fe06d163427822dc1598f420363759bb18155c9cc90eb1be05a64a19e AS production-deps
WORKDIR /app
COPY package.json bun.lock ./
RUN --mount=type=cache,id=mindbliss-bun,target=/root/.bun/install/cache,sharing=locked bun install --frozen-lockfile --production --omit=peer

FROM oven/bun:1.4.4-distroless@sha256:153a951ae40106e125898103e6e990ee0f38e6aee7f561029e26cf9fbed23470
WORKDIR /app
USER nonroot
COPY --from=production-deps --chown=nonroot:nonroot /app/node_modules ./node_modules
COPY --from=builder --chown=nonroot:nonroot /app/src ./src
COPY --from=builder --chown=nonroot:nonroot /app/package.json /app/tsconfig.json ./
ENV NODE_ENV=production PORT=3000 PGBOUNCER=false
EXPOSE 3000
ENTRYPOINT ["bun", "src/sandbox-wallet-server.ts"]
