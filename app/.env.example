# Postgres — reviewed application writer. Better Auth also needs its own
# auth.* write privileges (session/account/verification/rate_limit/jwks).
# A read-only role is not sufficient; never grant these privileges to PUBLIC.
# Production: connect through PgBouncer on the DB host (port 6432).
DATABASE_URL=postgres://app_write:CHANGEME@db.internal:6432/vicionpower

# Better Auth
BETTER_AUTH_SECRET=generate_with_openssl_rand_base64_32
BETTER_AUTH_URL=https://app.vicionpower.com
BETTER_AUTH_TRUSTED_ORIGINS=https://app.vicionpower.com
# Same secret on the BFF and auth backend. Keep the auth backend behind this gate.
AUTH_BFF_SHARED_SECRET=

# Redis — sessions cache + rate limit + BullMQ
REDIS_URL=redis://redis.internal:6379

# Email (transactional, for verification + password reset)
RESEND_API_KEY=re_change_me
AUTH_EMAIL_FROM=no-reply@example.invalid

# Features stay off until reviewed auth schema and delivery are configured.
# Sent.dm v3 supports SMS/WhatsApp/RCS, not email; email uses Resend above.
BETTER_AUTH_EMAIL_OTP_ENABLED=false
BETTER_AUTH_PHONE_OTP_ENABLED=false
BETTER_AUTH_JWT_ENABLED=false
BETTER_AUTH_JWT_ISSUER=
BETTER_AUTH_JWT_AUDIENCE=
SENTDM_API_KEY=
SENTDM_OTP_TEMPLATE_ID=
SENTDM_OTP_PARAMETER=code
SENTDM_OTP_CHANNEL=
SENTDM_PROFILE_ID=

# Optional OAuth providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Encryption key for mlm.person.ssn_encrypted (pgcrypto)
PII_ENCRYPTION_KEY=generate_with_openssl_rand_base64_32

NODE_ENV=production
PORT=3000
