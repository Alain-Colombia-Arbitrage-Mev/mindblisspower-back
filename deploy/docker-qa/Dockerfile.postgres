FROM postgres:17.11-bookworm@sha256:858bb5e98eed02eb8cafbcdc007f9a65d1b613972028944a8ec2133ccaf80d27
COPY _meta/*.sql /qa-schema/
COPY _meta/migration/*.sql /qa-schema/migration/
COPY deploy/docker-qa/init.sql /docker-entrypoint-initdb.d/001-qa.sql
