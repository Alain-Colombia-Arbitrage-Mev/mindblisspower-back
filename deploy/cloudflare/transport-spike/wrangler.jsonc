{
  "$schema": "../core/node_modules/wrangler/config-schema.json",
  "name": "mindbliss-grpc-transport-synthetic-local-only",
  "main": "worker.ts",
  "compatibility_date": "2026-10-25",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "containers": [
    { "class_name": "SyntheticEngine", "image": "./Dockerfile.engine", "max_instances": 1, "instance_type": "basic" },
    { "class_name": "SyntheticClient", "image": "./Dockerfile.client", "max_instances": 1, "instance_type": "basic" }
  ],
  "durable_objects": { "bindings": [
    { "name": "ENGINE", "class_name": "SyntheticEngine" },
    { "name": "CLIENT", "class_name": "SyntheticClient" }
  ] },
  "migrations": [{ "tag": "synthetic-local-only-v1", "new_sqlite_classes": ["SyntheticEngine", "SyntheticClient"] }],
  "dev": { "ip": "127.0.0.1", "port": 8797 }
}
