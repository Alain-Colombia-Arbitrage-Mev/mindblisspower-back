# Copy ONLY monitoring fields into backend/.env.local; never commit real values.
# This file is not uploaded. Sender keys must remain sending-only and separate.
# Real account-wide email quota: Resend Full Access is currently required by
# GET /usage. Isolate/revoke this monitoring key independently from the sender.
RESEND_MONITOR_API_KEY=
# Cloudflare: account Analytics Read scope, restricted to the intended account.
CLOUDFLARE_MONITOR_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# PlanetScale service token: read_branch on this one Postgres branch only.
PLANETSCALE_MONITOR_SERVICE_TOKEN_ID=
PLANETSCALE_MONITOR_SERVICE_TOKEN=
PLANETSCALE_MONITOR_ORGANIZATION=
PLANETSCALE_MONITOR_DATABASE=
PLANETSCALE_MONITOR_BRANCH=
# After publishing BOTH API image and Core Worker, configure these secrets in
# Core only, then explicitly enable CORE_OBSERVABILITY_ENABLED=true there.
# The existing API DO stores small rollups, not PlanetScale tables. Its private
# HMAC observation sink adds at most 500ms and never replays a send on failure.
# Existing five-minute cron performs reads only; admin polls its cached snapshot.
# Local counts begin on activation, are best-effort, exclude other applications,
# and do NOT prove inbox delivery or historical/account-wide quota. Cloudflare
# verified destinations can be exempt from quota; 200/day is owner-confirmed.
# Alert thresholds: quota80%warning/95%critical; CPU/memory/disk/connections use
# collector-specific explicit units and real provider values. Unknown is not OK.
# No automatic upgrade, failover, send, scale-up or financial mutation is enabled.
