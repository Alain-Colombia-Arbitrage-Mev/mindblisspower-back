{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mindbliss-wallet-core",
  "account_id": "ed805ed2b05218b41fc1d4d2440e658e",
  "main": "src/wallet-sandbox-worker.mjs",
  "compatibility_date": "2026-10-25",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "observability": { "enabled": false },
  "dev": { "enable_containers": false },
  "env": {
    "wallet": {
      "name": "mindbliss-wallet-core",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [],
      "vars": { "WALLET_MELD_PRODUCTION_ENABLED": "true" },
      "durable_objects": { "bindings": [{ "name": "WALLET_SANDBOX_CONTAINER", "class_name": "WalletSandboxApi" }] },
      "exports": { "WalletSandboxApi": { "type": "durable-object", "storage": "sqlite", "container": "wallet-sandbox-api" } },
      "containers": [{ "name": "wallet-sandbox-api", "image": "registry.cloudflare.com/ed805ed2b05218b41fc1d4d2440e658e/mindbliss/wallet-production-isolated:20261119-usdc-bank@sha256:02365eb2921d9af2d4e1c8f0cd4a99ed73c31b816e5eb2abaab58813faa833cc",
        "instance_type": "basic", "max_instances": 1, "scheduling_policy": "default", "rollout_kind": "full_auto", "rollout_step_percentage": 100 }]
    }
  }
}
