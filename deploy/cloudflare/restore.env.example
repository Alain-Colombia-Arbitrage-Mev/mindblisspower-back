# Use a NEW isolated staging branch and a dedicated restore role. No app credentials.
RESTORE_DATABASE_URL=postgresql://REPLACE_ROLE:REPLACE_PASSWORD@REPLACE_HOST.psdb.cloud:5432/postgres?sslmode=verify-full&sslrootcert=system
RESTORE_EXPECTED_DATABASE=postgres
RESTORE_CREDENTIAL_ROTATION_CONFIRMED=no
SOURCE_DATABASE_READY_CONFIRMED=no
SOURCE_REFERENCE=docker:mindbliss-local-recovery-20261022
SOURCE_DATABASE_NAME=replace_with_verified_source_db
