DATABASE_URL=postgres://REPLACE_APP_ROLE:REPLACE_PASSWORD@postgres:5432/mindbliss_staging?sslmode=disable
BETTER_AUTH_SECRET=REPLACE_RANDOM_AUTH_SECRET
BETTER_AUTH_URL=https://REPLACE_STAGING_API_HOST
BETTER_AUTH_TRUSTED_ORIGINS=https://REPLACE_STAGING_CLIENT_HOST,https://REPLACE_STAGING_ADMIN_HOST
PGBOUNCER=false

# Cloudflare Email Sending runs inside the existing Bun backend. No hosted
# Better Auth account/subscription or new auth service is required.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_EMAIL_API_TOKEN=
AUTH_EMAIL_FROM=
# Enable email only after migration 70 and reviewed auth.* writer permissions.
BETTER_AUTH_EMAIL_OTP_ENABLED=false
BETTER_AUTH_PHONE_OTP_ENABLED=false
BETTER_AUTH_JWT_ENABLED=false
# Coordinate the same minimum-32-character secret with the BFF before cutover.
AUTH_BFF_SHARED_SECRET=
