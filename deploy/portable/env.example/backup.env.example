DATABASE_URL=postgres://REPLACE_BACKUP_ROLE:REPLACE_PASSWORD@postgres:5432/mindbliss_staging?sslmode=disable
# Public age recipient only. Keep the PRIVATE identity offline, outside this service.
BACKUP_AGE_RECIPIENT=REPLACE_AGE_PUBLIC_RECIPIENT
BACKUP_INCLUDE_ROLES=1
# Required in production. Use an independent provider/account, NOT Railway storage.
BACKUP_S3_URI=s3://REPLACE_BUCKET/mindbliss
BACKUP_S3_ENDPOINT=https://REPLACE_S3_COMPATIBLE_ENDPOINT
AWS_ACCESS_KEY_ID=REPLACE_BACKUP_UPLOAD_KEY
AWS_SECRET_ACCESS_KEY=REPLACE_BACKUP_UPLOAD_SECRET
AWS_DEFAULT_REGION=us-east-1
# At least one destination; local output is enabled by Compose.
BACKUP_OUTPUT_DIR=/backups
PGCONNECT_TIMEOUT=15
