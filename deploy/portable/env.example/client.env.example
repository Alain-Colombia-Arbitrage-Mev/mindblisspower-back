PAYMENTS_SERVICE_TOKEN=REPLACE_SHARED_SERVICE_TOKEN
COGNITO_USER_POOL_ID=REPLACE_STAGING_POOL
COGNITO_CLIENT_ID=REPLACE_STAGING_CLIENT_ID
COGNITO_REGION=us-east-1
AWS_REGION=us-east-1
# A read-only role, NEVER the payments/engine role or postgres superuser.
MEMBER_DATABASE_URL=postgres://REPLACE_READ_ONLY_ROLE:REPLACE_PASSWORD@postgres:5432/mindbliss_staging
# Only on an isolated Docker network. For a remote DB use verified TLS.
MEMBER_DB_SSL=disable
REFERRAL_BASE_URL=https://REPLACE_STAGING_CLIENT_HOST
