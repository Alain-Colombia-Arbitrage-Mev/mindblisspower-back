DATABASE_URL=postgres://REPLACE_ENGINE_ROLE:REPLACE_PASSWORD@postgres:5432/mindbliss_staging?sslmode=disable
DB_MAX_CONNS=15
# No NATS-dependent integration is enabled in the initial core rollout.
# This invalid local address makes the existing optional connector fail closed.
NATS_URL=nats://127.0.0.1:1
BONUS_ENGINE_COMPANY_ROOT_AFFILIATE_ID=REPLACE_VALIDATED_ROOT_ID
BONUS_ENGINE_BINARY_CYCLE_ENABLED=false
