# Copy to runtime/staging/project.env; use absolute paths. Never commit real secrets.
DEPLOY_ENV=staging
RUNTIME_DIR=REPLACE_ABSOLUTE_RUNTIME_DIRECTORY
BACKUP_DIR=REPLACE_ABSOLUTE_BACKUP_DIRECTORY
# This is the tested QA PostgreSQL 17.10 / Timescale 2.27.2 base (not its QA schema).
POSTGRES_IMAGE=postgres:17.11-bookworm@sha256:858bb5e98eed02eb8cafbcdc007f9a65d1b613972028944a8ec2133ccaf80d27
REDIS_IMAGE=redis:7-alpine
CADDY_IMAGE=mindbliss/edge:REPLACE_RELEASE
# For production replace ALL image references with registry/repo@sha256:... .
API_IMAGE=mindbliss/api:REPLACE_RELEASE
ENGINE_IMAGE=mindbliss/engine:REPLACE_RELEASE
PAYMENTS_IMAGE=mindbliss/payments:REPLACE_RELEASE
WITHDRAWALS_IMAGE=mindbliss/withdrawals:REPLACE_RELEASE
CLIENT_IMAGE=mindbliss/client:REPLACE_RELEASE
ADMIN_IMAGE=mindbliss/admin:REPLACE_RELEASE
BACKUP_IMAGE=mindbliss/backup:REPLACE_RELEASE
