# falkordb — memoria de grafo para soporte RAG.
# Producción: /run/vicionpower/falkordb.env materializado desde
# /vicionpower/prod/falkordb/ por el deploy SSM.

FALKORDB_PASSWORD=CHANGE_ME
FALKORDB_BROWSER_ENCRYPTION_KEY=CHANGE_ME_64_HEX_OR_LONG_RANDOM_SECRET
FALKORDB_BROWSER_PORT=33000
FALKORDB_BROWSER_NEXTAUTH_URL=http://127.0.0.1:33000

# Mantener bind local; nunca abrir 6380 en Security Groups.
REDIS_ARGS=--bind 127.0.0.1 --port 6380 --requirepass CHANGE_ME --appendonly yes --appendfsync everysec --maxmemory 768mb --maxmemory-policy allkeys-lru
FALKORDB_ARGS=THREAD_COUNT 2 CACHE_SIZE 25 TIMEOUT_MAX 30000 TIMEOUT_DEFAULT 10000 QUERY_MEM_CAPACITY 67108864
