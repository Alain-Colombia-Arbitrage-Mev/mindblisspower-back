# vp-voice-agent — Pipecat Twilio Media Streams agent.
# Produccion: /run/vicionpower/vp-voice-agent.env generado desde
# /vicionpower/prod/vp-voice-agent/ por el deploy SSM.

APP_ENV=production
LOG_LEVEL=info

PIPECAT_HOST=0.0.0.0
PIPECAT_PORT=7860
PIPECAT_TRANSPORT=twilio
PIPECAT_PROXY_HOST=app.mindblisspower.com
# Twilio Media Streams no siempre envia Origin de navegador; la firma HMAC mb_*
# es el control de autenticacion del stream.
PIPECAT_ALLOWED_ORIGINS=

# El mismo secreto HMAC que PAYMENTS_PIPECAT_STREAM_SECRET.
PIPECAT_REQUIRE_STREAM_SIGNATURE=true
PIPECAT_STREAM_SECRET=CHANGE_ME
PIPECAT_STREAM_SIG_TTL_SEC=300

# LLM de voz y providers de audio. No subir llaves reales al repo.
OPENROUTER_API_KEY=CHANGE_ME
PIPECAT_OPENROUTER_MODEL=openai/gpt-4o-mini
DEEPGRAM_API_KEY=CHANGE_ME
CARTESIA_API_KEY=CHANGE_ME
CARTESIA_VOICE_ID=71a7ad14-091c-4e8e-a314-022ece01c121

# RAG de soporte existente.
PIPECAT_SUPPORT_AI_URL=http://127.0.0.1:9096
PIPECAT_SUPPORT_AI_SERVICE_TOKEN=CHANGE_ME

# Registro de turnos y tickets en vp-payments.
PIPECAT_PAYMENTS_URL=http://127.0.0.1:9095
PIPECAT_PAYMENTS_SERVICE_TOKEN=CHANGE_ME

# Opcional: permite que Pipecat cuelgue automaticamente al terminar la sesion.
TWILIO_ACCOUNT_SID=CHANGE_ME
TWILIO_AUTH_TOKEN=CHANGE_ME
